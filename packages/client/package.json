{
  "name": "@notemap/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./indexeddb": "./src/adapters/indexeddb-store.ts",
    "./filesystem": "./src/adapters/filesystem-store.ts"
  },
  "imports": {
    "#api/*": "./src/api/*.ts",
    "#state/*": "./src/state/*.ts",
    "#assets/*": "./src/assets/*.ts",
    "#capture/*": "./src/capture/*.ts",
    "#outbox/*": "./src/outbox/*.ts",
    "#ports/*": "./src/ports/*.ts",
    "#testing/*": "./src/testing/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "codegen": "openapi-typescript ../../apps/daemon/openapi.json -o src/api/generated.d.ts"
  },
  "peerDependencies": {
    "idb": "^8.0.3"
  },
  "peerDependenciesMeta": {
    "idb": {
      "optional": true
    }
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "idb": "^8.0.3",
    "openapi-typescript": "^7.13.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.1"
  }
}
