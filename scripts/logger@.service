# logger@.service — logs an error for the unit that triggered it, via log.sh.
#
# Use as a failure handler. The failing unit passes its own name as the
# instance, in its [Unit] section:
#
#   OnFailure=logger@%n.service
#
# Here %i is that name (e.g. memos-vault-sync.service). Use %i, NOT %I — %I
# would unescape '-' back to '/' and mangle the name. log.sh is called as:
#   log.sh error <service-name>
# Set the log.sh path in ExecStart below.

[Unit]
Description=Log error for %i

[Service]
Type=oneshot
ExecStart=/PATH/TO/log.sh error %i
