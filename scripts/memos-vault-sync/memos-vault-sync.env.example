# Copy to /etc/memos-vault-sync.env (chmod 600) and fill in.

# Memos server API endpoint (container-internal or localhost is fine).
MEMOS_URL=http://localhost:5230

# Personal access token: Memos web UI -> Settings -> My Account -> Access Tokens.
# Prefer MEMOS_TOKEN_FILE pointing at a chmod-600 file over inlining the token here.
#MEMOS_TOKEN=
MEMOS_TOKEN_FILE=/etc/memos-vault-sync.token

# Public web UI base URL, used for "url:" links in the notes' frontmatter.
# Defaults to MEMOS_URL if unset — set this if the API URL is container-internal.
#MEMOS_WEB_URL=https://memos.example.com

# Vault inbox folder the memo files are written into (server-side vault copy).
VAULT_INBOX_DIR=/path/to/vault/inbox

# Sync state (which memos are already synced). MUST live outside the vault.
STATE_FILE=/var/lib/memos-vault-sync/state.json

# Subfolder of VAULT_INBOX_DIR for downloaded attachments. Empty string disables
# attachment download (memos then reference the web UI instead).
#ATTACHMENTS_SUBDIR=attachments

# Octal mode for written note + attachment files. Default 0644 (Nextcloud
# standard: owner rw, group/other read) so other users/scripts can read them.
# Use 0640 to restrict reads to the owning group only.
#FILE_MODE=0644

# Extra seconds added to the incremental lookback window on top of the time
# elapsed since the last sync — margin for memos landing mid-sync and jitter.
# Overlap is free (unchanged memos are skipped), so err generous. Default 600.
#GRACE_SECONDS=600

# For the optional post-sync Nextcloud rescan (the ExecStartPost line in the
# unit). Only used if that line is uncommented. NC_SCAN_PATH is Nextcloud's
# VIRTUAL path (/<ncuser>/files/<path>/inbox) — the logical equivalent of
# VAULT_INBOX_DIR above, not the same filesystem string.
#NC_CONTAINER=nextcloud
#NC_SCAN_PATH=/<ncuser>/files/<path-to>/inbox
