[Unit]
Description=One-way sync of Memos into the Obsidian vault inbox
Wants=network-online.target
After=network-online.target
# On failure (script exits non-zero), start logger@memos-vault-sync.service.service
# -> log.sh error memos-vault-sync.service. Requires logger@.service installed.
OnFailure=logger@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/memos-vault-sync.env
ExecStart=/usr/bin/python3 /opt/notemap/scripts/memos-vault-sync/memos_to_vault.py
# Run as the uid/gid Nextcloud owns the vault files with (www-data inside the
# container = 33:33 on the host, even if no name resolves there). Numeric is
# fine; Group is set explicitly so files land 33:33 regardless of uid 33's
# primary group on the host.
User=33
Group=33
Nice=10

# After a successful sync, have Nextcloud index the externally-written files.
# '+' runs this line as root (needed for docker-socket access), bypassing User=33.
# NC_CONTAINER and NC_SCAN_PATH come from the EnvironmentFile, so this line stays
# generic — set them there, not here. (NC_SCAN_PATH is Nextcloud's *virtual* path,
# /<ncuser>/files/<path>/inbox, not VAULT_INBOX_DIR's filesystem path.)
# Test the command by hand first; use plain files:scan (not --unscanned) so edited
# memos are re-indexed. Optional: '+-' instead of '+' to not fail the sync if the
# scan errors; append --quiet to reduce journal noise.
#ExecStartPost=+/usr/bin/docker exec -u 33 ${NC_CONTAINER} php occ files:scan --path=${NC_SCAN_PATH}
