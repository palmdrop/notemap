# Copy to `.env`. Read by every package that points its own config here; nothing
# is loaded automatically, and nothing here is a secret — the app inlines any
# VITE_-prefixed value into a bundle it ships to the browser.

# The port the daemon is on in dev, which is what vite proxies /v1 to. The
# daemon itself takes its port from `daemon.port` in its TOML config, not from
# here: set this to match when you run it somewhere other than the default.
NOTEMAP_PORT=4747

# Same-origin by default: dev proxies to the daemon, and in production the
# daemon serves the app itself. Set an absolute URL only for a shell that
# cannot be same-origin (a native build, a phone on the LAN), which reopens the
# auth question — see docs/specs/security.md.
# VITE_API_URL=http://localhost:4747
