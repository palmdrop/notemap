# Env & secrets  (keep the *.example templates tracked)
.env
*.env
!*.env.example
!.env.example
# The deploy folder is copied to a host whole, so its .env ships with it. It
# holds an image tag and a network name; a secret must never go in this one.
!docker/compose/.env
*.pem
*.key
# A self-signed key for `unfurl.test`, trusted by nothing but the TLS tests.
!apps/daemon/src/testing/tls/unfurl.test.key

# A pool and everything around it (ADR 1). A pool normally lives outside the
# repo, but dev runs and tests put one here.
#
# Anchored to the root, all of them: unanchored, `assets/` matched at every
# depth and quietly swallowed `apps/daemon/src/assets/`. A pool under `data/`
# is covered by `data/` itself.
/data/
/state/
/pool-mirror/
/assets/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal

# Swagger UI, copied out of node_modules by the daemon's build step.
apps/daemon/public/vendor/

# The app, copied out of apps/ui/build by the daemon's build step.
apps/daemon/public/ui/

# Inspirational material
docs/inspiration/

# Node / TypeScript (pnpm). pnpm-lock.yaml is committed on purpose — do not add it here.
node_modules/
.pnpm-store/
dist/
build/
.cache/
coverage/
*.tsbuildinfo

# Logs
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#

# agents
.claude/worktrees/
.claude/artifacts/
.claude/settings.local.json
